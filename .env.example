# ============================================
# LICENSE SERVER CONFIGURATION
# ============================================
# Copy this file to .env and update with your actual values
# NEVER commit .env to version control!

# --------------------------------------------
# APPLICATION SETTINGS
# --------------------------------------------
APP_NAME="License Server"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://yourdomain.com
APP_TIMEZONE=UTC

# Application Key (Generate with: php -r "echo bin2hex(random_bytes(32));")
APP_KEY=

# Encryption Method (AES-256-CBC or AES-256-GCM)
CIPHER_METHOD=AES-256-GCM

# --------------------------------------------
# DATABASE CONFIGURATION (Hostinger MySQL)
# --------------------------------------------
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u123456789_licenses
DB_USERNAME=u123456789_admin
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_PREFIX=

# --------------------------------------------
# CRYPTOGRAPHIC KEYS (RSA 4096-bit)
# --------------------------------------------
# Generate keypairs using: php scripts/generate-keypair.php
SERVER_PRIVATE_KEY=/home/username/domains/yourdomain.com/storage/keys/server_private.key
SERVER_PUBLIC_KEY=/home/username/domains/yourdomain.com/storage/keys/server_public.key
KEY_PASSPHRASE=

# Key rotation settings
KEY_ROTATION_ENABLED=false
KEY_ROTATION_DAYS=365

# --------------------------------------------
# SESSION SECURITY
# --------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=30
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict
SESSION_PATH=/home/username/domains/yourdomain.com/storage/sessions

# --------------------------------------------
# ADMIN PANEL SECURITY
# --------------------------------------------
ADMIN_2FA_REQUIRED=true
ADMIN_SESSION_TIMEOUT=1800
ADMIN_ABSOLUTE_TIMEOUT=28800

# IP Whitelisting (comma-separated IPs or CIDR ranges)
ADMIN_IP_WHITELIST=
ADMIN_IP_WHITELIST_ENABLED=false

# Login security
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION=900
LOGIN_LOCKOUT_NOTIFY=true

# Password policies
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SYMBOLS=true
PASSWORD_EXPIRY_DAYS=90
PASSWORD_HISTORY_COUNT=10
PASSWORD_CHECK_BREACHED=true

# --------------------------------------------
# BACKUP CONFIGURATION
# --------------------------------------------
BACKUP_ENABLED=true
BACKUP_PATH=/home/username/domains/yourdomain.com/storage/backups
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_ENCRYPTION_ENABLED=true
BACKUP_ENCRYPTION_KEY=

# Backup retention
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=12

# Amazon S3 Backup
BACKUP_S3_ENABLED=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# SFTP Backup
BACKUP_SFTP_ENABLED=false
SFTP_HOST=
SFTP_PORT=22
SFTP_USERNAME=
SFTP_PASSWORD=
SFTP_ROOT=/backups
SFTP_PRIVATE_KEY=

# Dropbox Backup
BACKUP_DROPBOX_ENABLED=false
DROPBOX_ACCESS_TOKEN=

# --------------------------------------------
# EMAIL CONFIGURATION (Hostinger SMTP)
# --------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="${APP_NAME}"

# Email notifications
MAIL_NOTIFY_LICENSE_CREATED=true
MAIL_NOTIFY_LICENSE_ACTIVATED=true
MAIL_NOTIFY_LICENSE_EXPIRED=true
MAIL_NOTIFY_LICENSE_EXPIRING_DAYS=7,3,1
MAIL_NOTIFY_SUSPICIOUS_ACTIVITY=true

# --------------------------------------------
# SMS NOTIFICATIONS (Twilio)
# --------------------------------------------
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_NOTIFY_CRITICAL_EVENTS=true

# --------------------------------------------
# PAYMENT GATEWAY (Stripe)
# --------------------------------------------
STRIPE_ENABLED=false
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=USD

# PayPal
PAYPAL_ENABLED=false
PAYPAL_MODE=live
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# --------------------------------------------
# LICENSE CONFIGURATION
# --------------------------------------------
# Default license settings
LICENSE_DEFAULT_DURATION_DAYS=365
LICENSE_GRACE_PERIOD_DAYS=7
LICENSE_MAX_ACTIVATIONS=1
LICENSE_ALLOW_DEACTIVATION=true
LICENSE_ALLOW_TRANSFER=true
LICENSE_TRANSFER_COOLDOWN_DAYS=30

# Hardware fingerprint components
FINGERPRINT_USE_CPU_ID=true
FINGERPRINT_USE_MAC_ADDRESS=true
FINGERPRINT_USE_DISK_SERIAL=true
FINGERPRINT_USE_MOTHERBOARD_ID=true
FINGERPRINT_USE_BIOS_SERIAL=true

# License key format
LICENSE_KEY_LENGTH=25
LICENSE_KEY_SEGMENTS=5
LICENSE_KEY_SEPARATOR=-

# --------------------------------------------
# PING/HEARTBEAT SYSTEM
# --------------------------------------------
PING_ENABLED=true
PING_INTERVAL_SECONDS=300
PING_TIMEOUT_MINUTES=15
PING_MISSED_THRESHOLD=3
PING_NOTIFY_MISSED=true

# --------------------------------------------
# RATE LIMITING & SECURITY
# --------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_ATTEMPTS=60
RATE_LIMIT_DECAY_MINUTES=1
RATE_LIMIT_API_MAX_ATTEMPTS=100

# DDoS Protection
DDOS_PROTECTION_ENABLED=true
DDOS_MAX_REQUESTS_PER_MINUTE=120
DDOS_BAN_DURATION_MINUTES=60

# CAPTCHA (hCaptcha or reCAPTCHA)
CAPTCHA_ENABLED=false
CAPTCHA_PROVIDER=hcaptcha
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# --------------------------------------------
# API CONFIGURATION
# --------------------------------------------
API_ENABLED=true
API_VERSION=v1
API_RATE_LIMIT=60
API_TOKEN_EXPIRY_DAYS=90

# CORS Settings
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With

# --------------------------------------------
# WEBHOOKS
# --------------------------------------------
WEBHOOK_ENABLED=false
WEBHOOK_TIMEOUT_SECONDS=30
WEBHOOK_RETRY_ATTEMPTS=3
WEBHOOK_VERIFY_SSL=true

# --------------------------------------------
# CACHING
# --------------------------------------------
CACHE_DRIVER=file
CACHE_PATH=/home/username/domains/yourdomain.com/storage/cache
CACHE_DEFAULT_TTL=3600

# Redis (if available on your Hostinger plan)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DATABASE=0

# --------------------------------------------
# LOGGING
# --------------------------------------------
LOG_CHANNEL=stack
LOG_LEVEL=warning
LOG_PATH=/home/username/domains/yourdomain.com/storage/logs
LOG_MAX_FILES=30
LOG_DAILY=true

# Audit logging
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=365

# --------------------------------------------
# GEOLOCATION
# --------------------------------------------
GEO_ENABLED=false
GEO_PROVIDER=ipapi
GEO_API_KEY=

# Geographic restrictions
GEO_RESTRICTIONS_ENABLED=false
GEO_BLOCKED_COUNTRIES=
GEO_ALLOWED_COUNTRIES=

# --------------------------------------------
# MAINTENANCE MODE
# --------------------------------------------
MAINTENANCE_MODE=false
MAINTENANCE_SECRET=
MAINTENANCE_ALLOWED_IPS=

# --------------------------------------------
# FEATURES FLAGS
# --------------------------------------------
FEATURE_FLOATING_LICENSES=true
FEATURE_TRIAL_LICENSES=true
FEATURE_LICENSE_BUNDLES=true
FEATURE_RESELLER_PORTAL=false
FEATURE_CUSTOMER_PORTAL=true
FEATURE_ANALYTICS=true
FEATURE_COMPLIANCE_CHECKER=true

# --------------------------------------------
# QUEUE SYSTEM
# --------------------------------------------
QUEUE_DRIVER=sync
QUEUE_CONNECTION=default

# --------------------------------------------
# TIMEZONE
# --------------------------------------------
TIMEZONE=UTC
DATE_FORMAT="Y-m-d H:i:s"

# --------------------------------------------
# DEBUGGING & DEVELOPMENT
# --------------------------------------------
# NEVER enable these in production!
DEBUG_SHOW_ERRORS=false
DEBUG_SQL_QUERIES=false
DEBUG_LOG_REQUESTS=false
